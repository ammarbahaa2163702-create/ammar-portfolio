body, html, .menu, .modals
    font-family "Cairo", "Nunito", sans-serif

.arabic-text
    font-family "Cairo", sans-serif
    direction rtl
    text-align right
    line-height 1.7

.english-text
    direction ltr
    text-align left
    line-height 1.5

[dir="rtl"]
    direction rtl
    text-align right

[dir="auto"]
    unicode-bidi plaintext

