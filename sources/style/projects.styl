.projects-content
    .projects-list
        display flex
        flex-direction column
        gap 16px
        margin-top 1.2rem
        max-height calc(80vh - 160px)
        overflow-y auto
        padding-right 8px

        &::-webkit-scrollbar
            width 6px

        &::-webkit-scrollbar-thumb
            background rgba(255, 206, 202, 0.3)
            border-radius 4px

    .project-card
        background rgba(255, 255, 255, 0.04)
        border 1px solid rgba(255, 206, 202, 0.3)
        border-radius 8px
        padding 14px 16px
        text-align start
        transition border-color 0.2s, background-color 0.2s

        &:hover
            border-color #ffceca
            background rgba(255, 255, 255, 0.07)

        .card-header
            display flex
            justify-content space-between
            align-items baseline
            margin-bottom 6px

            .project-title
                font-size 1.15rem
                font-weight 700
                color #ffceca
                font-family "Cairo", sans-serif

            .project-badge
                font-size 0.75rem
                opacity 0.7
                color #ffffff

        .project-desc
            font-size 0.95rem
            line-height 1.6
            margin-bottom 8px
            color #e0e0e0
            font-family "Cairo", sans-serif

        .project-tags
            display flex
            flex-wrap wrap
            gap 6px

            .tag
                font-size 0.75rem
                padding 3px 8px
                background rgba(255, 206, 202, 0.15)
                color #ffffff
                border-radius 4px
                font-family "Nunito", sans-serif

